<?xml version="1.0" encoding="UTF-8"?>
<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.1">
  <meiHead>
    <fileDesc>
      <titleStmt>
        <title>Piano Test</title>
        <composer>Test Composer</composer>
      </titleStmt>
      <pubStmt/>
    </fileDesc>
  </meiHead>
  <music>
    <body>
      <mdiv>
        <score>
          <scoreDef keysig="1s" meter.count="4" meter.unit="4">
            <staffGrp symbol="brace" bar.thru="true">
              <staffDef n="1" lines="5" clef.shape="G" clef.line="2"/>
              <staffDef n="2" lines="5" clef.shape="F" clef.line="4"/>
            </staffGrp>
          </scoreDef>
          <section>
            <measure n="1">
              <staff n="1">
                <layer n="1">
                  <note dur="4" dots="1" pname="g" oct="4"/>
                  <note dur="8" pname="a" oct="4"/>
                  <beam>
                    <note dur="8" pname="b" oct="4"/>
                    <note dur="8" pname="c" oct="5"/>
                    <note dur="8" pname="d" oct="5"/>
                    <note xml:id="t1" dur="8" pname="e" oct="5"/>
                  </beam>
                </layer>
              </staff>
              <staff n="2">
                <layer n="1">
                  <chord dur="2">
                    <note pname="g" oct="2"/>
                    <note pname="d" oct="3"/>
                    <note pname="g" oct="3"/>
                  </chord>
                  <rest dur="4"/>
                  <chord dur="4">
                    <note pname="d" oct="3"/>
                    <note pname="f" oct="3" accid.ges="s"/>
                    <note pname="a" oct="3"/>
                  </chord>
                </layer>
              </staff>
              <tie startid="#t1" endid="#t2"/>
            </measure>
            <measure n="2" right="end">
              <staff n="1">
                <layer n="1">
                  <note xml:id="t2" dur="2" pname="e" oct="5"/>
                  <rest dur="4"/>
                  <note dur="4" pname="d" oct="5"/>
                </layer>
              </staff>
              <staff n="2">
                <layer n="1">
                  <note dur="2" pname="g" oct="2" tie="i"/>
                  <note dur="2" pname="g" oct="2" tie="t"/>
                </layer>
              </staff>
            </measure>
          </section>
        </score>
      </mdiv>
    </body>
  </music>
</mei>
